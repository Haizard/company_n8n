# Vercel container entrypoint for n8n.
#
# The repository's own Dockerfile (docker/images/n8n/Dockerfile) cannot be built
# by Vercel: it copies the `compiled/` artifact from `pnpm build:deploy` and
# needs the BUILDER_IMAGE / RUNTIME_IMAGE build arguments from
# docker/docker-bake.hcl. Start from the published image instead.
#
# Pull through Google's Docker Hub mirror. docker.n8n.io and ghcr.io serve the
# same manifest, but Vercel's shared build addresses exhaust the anonymous
# Docker Hub pull limit. This mirror returns the same digest, sha256:63bdcfde.
FROM mirror.gcr.io/n8nio/n8n:2.48.4

# n8n listens on N8N_PORT (default 5678) and runs as a non-root user, so it
# cannot bind port 80. Vercel routes traffic to $PORT, so set PORT=5678 in the
# Vercel project's environment variables.
ENV N8N_PORT=5678

# Bind on all interfaces so the platform's health probe on 127.0.0.1 reaches the
# server, and so n8n does not wait on the database before opening the port.
ENV N8N_LISTEN_ADDRESS=0.0.0.0
